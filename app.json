{
  "expo": {
    "name": "TEA Autonomia",
    "slug": "tea-mvp",
    "version": "1.0.9",
    "orientation": "default",
    "scheme": "tea",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#1A1D23",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#1A1D23",
      "resizeMode": "contain",
      "image": "./assets/splash.png"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.teamvp.app",
      "icon": "./assets/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A1D23",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "package": "com.teamvp.app",
      "versionCode": 9
    },
    "plugins": [
      "expo-router",
      "./plugins/withCrisisWidget"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "57309983-779d-4853-8f9c-642ee62e256f"
      }
    },
    "owner": "valdenortavares"
  }
}
